# Rust build artifacts
/target/
**/*.rs.bk
*.pdb

# Experimental crates are standalone packages: each one makes its own lock file.
crates/experimental/*/Cargo.lock
crates/experimental/*/target/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Temp files and local state
*.tmp
*.bak
*.db
*.db-journal
.env.local

# Python
__pycache__/
.pytest_cache/
*.egg-info/
detective/.venv/
detective/.deps/

# Courtroom (Node)
# Build output and installed packages are never committed: `npm ci` and `npm run build`
# recreate them. `scripts/check.sh` builds them before the Playwright tests run.
courtroom/node_modules/
courtroom/dist/
courtroom/test-results/
courtroom/playwright-report/
courtroom/.vite/

# Internal notes: kept local. brain.md and CLAUDE.md are tracked in the private repo (backup); the master plan is not.
AgentCop Master Build Plan and Claude Code Prompt.md

# Docs are tracked. Generated or private output under docs/ stays out: databases and raw evidence.
docs/**/*.db
docs/**/evidence/
